# Local authentication and tool configuration.
.netrc
.npmrc
.pypirc
terraform.tfstate
terraform.tfstate.*
*.tfvars
*.tfvars.json
# Markdown: keep only these filenames at any directory depth.
*.[mM][dD]
!INFORME.md
!README.md

# Entorno y archivos temporales del notebook serial.
.venv-oracle/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Capturas distribuidas por GitHub Releases; conservar metadatos y esquemas.
/dist/dataset/
/dataset/**/*.parquet
